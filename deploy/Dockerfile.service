# Generic image for the dependency-free services: aggregator, bureau, scheduler.   docker build -f deploy/Dockerfile.service --build-arg SERVICE=aggregator .
FROM node:22-slim
ARG SERVICE
ENV NODE_ENV=production
WORKDIR /srv
COPY packages/shared ./packages/shared
COPY services/${SERVICE} ./services/${SERVICE}
WORKDIR /srv/services/${SERVICE}
RUN mkdir -p /data && chown -R node:node /data /srv
USER node
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||80)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/main.ts"]
