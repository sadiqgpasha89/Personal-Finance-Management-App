# --- required ---
INTERNAL_API_SECRET=            # 32+ random characters; shared by all services (openssl rand -hex 32)
PUBLIC_URL=http://localhost:3100
# --- Account Aggregator (default: built-in sandbox) ---
AA_MODE=sandbox                 # sandbox | live
# live mode needs FIU registration with an RBI-licensed AA (e.g. Anumati/CAMS Finserv, Finvu, OneMoney):
# AA_BASE_URL=  FIU_ID=  FIU_API_KEY=  FIU_PRIVATE_KEY_PEM=  AA_PUBLIC_KEY_PEM=  AA_REDIRECT_TEMPLATE=https://aa.example/consent?handle={handle}&redirect={redirect}
# --- Credit bureau (default: sample data) ---
BUREAU_PROVIDER=sandbox         # sandbox | http (licensed partner, see services/bureau/src/providers.ts)
# BUREAU_BASE_URL=  BUREAU_API_KEY=
# --- Assistant ---
CHAT_RETENTION_DAYS=90
# ASSISTANT_PROVIDER=llama      # default. 'anthropic' also needs ALLOW_EXTERNAL_AI=1 and sends data off-site: leave unset to keep everything on-device.
