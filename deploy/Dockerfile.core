# The Next.js core (UI + REST API + ledger). Built from the repo root so ../packages/shared is available.
FROM node:22-slim AS build
WORKDIR /srv
COPY packages/shared ./packages/shared
COPY app/package.json app/package-lock.json ./app/
RUN cd app && npm ci
COPY app ./app
RUN cd app && NEXT_OUTPUT=standalone npm run build
FROM node:22-slim
ENV NODE_ENV=production PORT=3100 HOSTNAME=0.0.0.0 LEDGERLY_DB=/data/ledgerly.db
WORKDIR /srv
COPY --from=build /srv/app/.next/standalone ./
COPY --from=build /srv/app/.next/static ./app/.next/static
COPY --from=build /srv/app/public ./app/public
RUN mkdir -p /data && chown -R node:node /data /srv
USER node
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:3100/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "app/server.js"]
